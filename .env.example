# Malta Lightning Monitoring System - Environment Variables
# Copy this file to .env and fill in your actual credentials

# Blitzortung.org
# To access real-time data, you may need to join the network
# or use a third-party relay service
BLITZORTUNG_API_KEY=your_api_key_here
BLITZORTUNG_STATION_ID=your_station_id_here

# Windy API
# Get your API key from: https://api.windy.com/keys
WINDY_API_KEY=your_windy_api_key_here

# OpenWeatherMap API
# Free tier available at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# EUMETSAT (optional)
# Requires registration: https://eoportal.eumetsat.int/
EUMETSAT_CONSUMER_KEY=your_consumer_key_here
EUMETSAT_CONSUMER_SECRET=your_consumer_secret_here

# Telegram Bot (for notifications)
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Email notifications (SMTP)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_FROM=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here
EMAIL_TO=recipient@example.com

# Pushover (optional push notifications)
# Get credentials from: https://pushover.net/
PUSHOVER_USER_KEY=your_pushover_user_key_here
PUSHOVER_API_TOKEN=your_pushover_api_token_here

# Redis (optional - for distributed caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Database
DATABASE_URL=sqlite:///lightning_monitor/data/cache/weather_data.db

# System settings
LOG_LEVEL=INFO
TIMEZONE=Europe/Malta

# Testing and development
DEBUG_MODE=false
SILENT_MODE=false
