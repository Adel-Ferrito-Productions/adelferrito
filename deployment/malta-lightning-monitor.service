[Unit]
Description=Malta Lightning Monitoring System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lightning
Group=lightning
WorkingDirectory=/opt/malta-lightning-monitor
Environment="PATH=/opt/malta-lightning-monitor/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="PYTHONPATH=/opt/malta-lightning-monitor"
Environment="PYTHONUNBUFFERED=1"

# Load environment variables
EnvironmentFile=/opt/malta-lightning-monitor/.env

# Main command
ExecStart=/opt/malta-lightning-monitor/venv/bin/python /opt/malta-lightning-monitor/main.py

# Restart policy
Restart=always
RestartSec=10
StartLimitInterval=5min
StartLimitBurst=4

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=malta-lightning-monitor

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/malta-lightning-monitor/lightning_monitor/data

# Resource limits
MemoryLimit=512M
CPUQuota=80%

[Install]
WantedBy=multi-user.target
